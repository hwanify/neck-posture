{
  "expo": {
    "name": "바로목",
    "slug": "baromok",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.hwanify.baromok",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMotionUsageDescription": "Baromok uses your AirPods’ motion sensor to detect when your head tilts to one side.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "./plugins/withoutPushEntitlement"
    ],
    "extra": {
      "eas": {}
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "ja": "./locales/ja.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "hi": "./locales/hi.json"
    }
  }
}
