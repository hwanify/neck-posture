{
  "expo": {
    "name": "Plumb",
    "slug": "baromok",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.hwanify.baromok",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMotionUsageDescription": "Plumb uses your AirPods’ motion sensor to detect when your head tilts to one side.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSupportsLiveActivities": true
      }
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {}
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "ja": "./locales/ja.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "hi": "./locales/hi.json"
    }
  }
}
